FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
PUBLIC_BASE_URL=http://127.0.0.1:5000

# ── Database ──────────────────────────────────────────────
# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///tripvault.db
# PostgreSQL (when you have a server):
# DATABASE_URL=postgresql://user:password@localhost/tripvault

# ── Encryption ────────────────────────────────────────────
# Must be exactly 32 ASCII characters
ENCRYPTION_KEY=60487124657876f5244a49ae2bdaf564

# ── Email (choose one option below) ───────────────────────

# Option A: Gmail SMTP
# 1. Enable 2FA on your Google account
# 2. Create an App Password at: https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=TripVault <your-gmail@gmail.com>

# Option B: Mailtrap (free email sandbox for testing)
# Sign up at https://mailtrap.io  →  Inboxes → SMTP Settings
# MAIL_SERVER=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USE_TLS=true
# MAIL_USERNAME=<mailtrap-username>
# MAIL_PASSWORD=<mailtrap-password>
# MAIL_DEFAULT_SENDER=TripVault <noreply@tripvault.dev>

# ── AWS (Phase 4 — leave blank until you have an account) ─
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=tripvault-documents
